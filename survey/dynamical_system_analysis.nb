           RowBox[{"-", "aVM"}], " ", "BVM"}], "+", 
          RowBox[{"AVM", " ", "F2VM"}], "+", 
          RowBox[{"F1VM", " ", "F2VM"}]}], ")"}]}]]}], ",", 
     RowBox[{"x2VM", "\[Rule]", 
      FractionBox[
       RowBox[{
        RowBox[{
         RowBox[{"-", "aVM"}], " ", "BVM"}], "+", 
        RowBox[{"AVM", " ", "F2VM"}], "+", 
