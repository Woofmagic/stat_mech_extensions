Cell[CellGroupData[{

Cell["(#0.2.1): Classifying FOD Fixed Points:", "Subtitle",
 CellChangeTimes->{{3.996332365451667*^9, 
  3.9963323732117043`*^9}},ExpressionUUID->"8d4413d2-6af4-42dd-88f5-\
2e77fa911d54"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ClassifyFixedPoint", "[", 
   RowBox[{"\[Tau]_", ",", "\[CapitalDelta]_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "disc", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"disc", "=", 
      RowBox[{
       SuperscriptBox["\[Tau]", "2"], "-", 
       RowBox[{"4", "\[CapitalDelta]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Which", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[CapitalDelta]", "<", "0"}], ",", "\"\<Saddle Point\>\"", 
       ",", 
       RowBox[{"\[CapitalDelta]", "==", "0"}], ",", 
       "\"\<Non-isolated (at least one zero eigenvalue)\>\"", ",", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"Stable", " ", 
         RowBox[{"cases", ":", " ", 
          RowBox[{"tau", " ", "<", " ", "0"}]}]}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\[Tau]", "<", "0"}], "&&", 
        RowBox[{"disc", ">", "0"}]}], ",", "\"\<Stable Node\>\"", ",", 
       RowBox[{
        RowBox[{"\[Tau]", "<", "0"}], "&&", 
        RowBox[{"disc", "==", "0"}]}], ",", "\"\<Degenerate Stable Node\>\"", 
       ",", 
       RowBox[{
        RowBox[{"\[Tau]", "<", "0"}], "&&", 
        RowBox[{"disc", "<", "0"}]}], ",", "\"\<Stable Spiral\>\"", ",", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"Unstable", " ", 
         RowBox[{"cases", ":", " ", 
          RowBox[{"tau", " ", ">", " ", "0"}]}]}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\[Tau]", ">", "0"}], "&&", 
        RowBox[{"disc", ">", "0"}]}], ",", "\"\<Unstable Node\>\"", ",", 
       RowBox[{
        RowBox[{"\[Tau]", ">", "0"}], "&&", 
        RowBox[{"disc", "==", "0"}]}], ",", 
       "\"\<Degenerate Unstable Node\>\"", ",", 
       RowBox[{
        RowBox[{"\[Tau]", ">", "0"}], "&&", 
        RowBox[{"disc", "<", "0"}]}], ",", "\"\<Unstable Spiral\>\"", ",", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"Neutral", " ", 
          RowBox[{"case", ":", " ", "tau"}]}], " ", "=", " ", "0"}], " ", 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\[Tau]", "==", "0"}], "&&", 
        RowBox[{"\[CapitalDelta]", ">", "0"}]}], ",", "\"\<Center\>\"", ",", 
       "True", ",", "\"\<Unknown/Borderline Case\>\""}], 
      "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.977500886081038*^9, 3.977500934418509*^9}, {
  3.992688328076704*^9, 3.992688337755205*^9}, {3.996332251971827*^9, 
  3.9963322895188913`*^9}, {3.996332324345879*^9, 
  3.996332325508703*^9}},ExpressionUUID->"34606dd9-230c-418a-85fa-\
2e2f429d2f41"]
}, Closed]],

Cell[CellGroupData[{

Cell["(#1): 1D Simple Harmonic Oscillator:", "Chapter",
 CellChangeTimes->{{3.976474579606308*^9, 3.976474590148712*^9}, {
   3.976474625390904*^9, 3.9764746271700277`*^9}, 3.976475223433807*^9, 
   3.9773238156579447`*^9},ExpressionUUID->"7e437f03-1d2c-41c5-b77f-\
e45ef99388a4"],

Cell[CellGroupData[{

Cell["(#1.1): Dynamical Equations:", "Section",
 CellChangeTimes->{{3.976474614798009*^9, 
  3.9764746199177017`*^9}},ExpressionUUID->"75a6b3d8-4bb0-4c20-a415-\
25f276b2636f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f1SHO", "[", "t_", "]"}], ":=", 
   FractionBox[
    RowBox[{"x2SHO", "[", "t", "]"}], "m"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f2SHO", "[", "t_", "]"}], ":=", 
   RowBox[{
    RowBox[{"-", "m"}], " ", 
    SuperscriptBox["\[Omega]", "2"], 
    RowBox[{"x1SHO", "[", "t", "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.976474622829844*^9, 3.9764747080054417`*^9}, {
  3.9764751811476173`*^9, 3.976475195215659*^9}, {3.976475680563899*^9, 
  3.9764757013480043`*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"5aeab9cc-e7a3-46f4-af0f-78f128fe52a1"]
}, Open  ]],

Cell["(#1.2): Fixed Point Analysis:", "Section",
 CellChangeTimes->{{3.976474602309332*^9, 3.976474613227508*^9}, {
  3.977323099017982*^9, 
  3.977323099228149*^9}},ExpressionUUID->"033a7c39-9cc3-4cfd-af53-\
ab1bc1e13f70"]
}, Open  ]],

Cell[CellGroupData[{

Cell["(#1.2.1): Finding Fixed Points:", "Subtitle",
 CellChangeTimes->{{3.976474811756517*^9, 3.976474841206863*^9}, {
  3.9773231003074627`*^9, 
  3.977323100403637*^9}},ExpressionUUID->"a2977b5a-0a11-42cf-a094-\
52eb1efb988b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"fixedPointsSHO", "=", 
  RowBox[{"Solve", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      FractionBox["x2SHO", "m"], "==", "0"}], "&&", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "m"}], " ", 
       SuperscriptBox["\[Omega]", "2"], "x1SHO"}], "==", "0"}]}], ",", " ", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"x1SHO", ",", " ", "x2SHO"}], "}"}], ",", "\[IndentingNewLine]", 
    "Reals", ",", "\[IndentingNewLine]", 
    RowBox[{"Assumptions", "->", 
     RowBox[{
      RowBox[{"m", "\[Element]", 
       RowBox[{
        RowBox[{"Reals", "**", "m"}], ">", "0"}]}], "&&", 
      RowBox[{"\[Omega]", "\[Element]", "Reals"}], "&&", 
      RowBox[{"\[Omega]", ">", "0"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9764748630475607`*^9, 3.976474863847884*^9}, {
   3.976474898543268*^9, 3.976474935077127*^9}, {3.9764751965149927`*^9, 
   3.976475206077334*^9}, 3.976475331701157*^9, {3.976475535504415*^9, 
   3.976475564853271*^9}, {3.976475903601872*^9, 3.976475906975328*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"445ff9f8-5e0c-4acb-b21f-4e005d352e85"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"x1SHO", "\[Rule]", "0"}], ",", 
    RowBox[{"x2SHO", "\[Rule]", "0"}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{3.9764755651374063`*^9, 3.976475907214117*^9, 
  3.9764763032973413`*^9, 3.977323079778885*^9, 3.977323147007196*^9, 
  3.99268842543219*^9, 3.99270170548166*^9, 3.9927019544800577`*^9},
 CellLabel->"Out[4]=",ExpressionUUID->"ad457180-1841-4b38-bfda-0eefdf676a03"]
}, Open  ]]
}, Closed]],

