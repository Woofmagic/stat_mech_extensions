Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"fixedPointsVM", "=", 
  RowBox[{"Solve", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"x1VM", 
       RowBox[{"(", 
        RowBox[{"AVM", "+", 
         RowBox[{"BVM", " ", "x1VM"}], "+", "F1VM"}], " ", ")"}]}], "==", 
      "0"}], "&&", 
     RowBox[{
      RowBox[{"x2VM", 
       RowBox[{"(", 
        RowBox[{"aVM", "+", 
         RowBox[{"bVM", " ", "x2VM"}], "+", 
         RowBox[{"F2VM", " ", "x1VM"}]}], ")"}]}], "==", "0"}]}], ",", " ", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"x1VM", ",", " ", "x2VM"}], "}"}], ",", "\[IndentingNewLine]", 
    "Reals", ",", "\[IndentingNewLine]", 
    RowBox[{"Assumptions", "->", 
     RowBox[{
      RowBox[{"AVM", "\[Element]", "Reals"}], "&&", 
      RowBox[{"AVM", ">", "0"}], "&&", 
      RowBox[{"BVM", "\[Element]", "Reals"}], "&&", 
      RowBox[{"BVM", ">", "0"}], "&&", 
      RowBox[{"F1VM", "\[Element]", "Reals"}], "&&", 
      RowBox[{"F1VM", ">", "0"}], "&&", 
      RowBox[{"aVM", "\[Element]", "Reals"}], "&&", 
      RowBox[{"aVM", ">", "0"}], "&&", 
      RowBox[{"bVM", "\[Element]", "Reals"}], "&&", 
      RowBox[{"bVM", ">", "0"}], "&&", 
      RowBox[{"F2VM", "\[Element]", "Reals"}], "&&", 
      RowBox[{"F2VM", ">", "0"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.976475341444745*^9, 3.976475382892358*^9}, {
