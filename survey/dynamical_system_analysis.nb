Cell["(#1.2.2.1): General Matrix of Linearized System", "Subsection",
 CellChangeTimes->{{3.977324196635531*^9, 
  3.977324220910582*^9}},ExpressionUUID->"90542935-66c9-4b90-bb73-\
e59c633b2721"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"linearizationMatrixSHO", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"f1SHO", "[", "t", "]"}], ",", 
         RowBox[{"x1SHO", "[", "t", "]"}]}], "]"}], ",", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"f1SHO", "[", "t", "]"}], ",", 
         RowBox[{"x2SHO", "[", "t", "]"}]}], "]"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"f2SHO", "[", "t", "]"}], ",", 
         RowBox[{"x1SHO", "[", "t", "]"}]}], "]"}], ",", 
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"f2SHO", "[", "t", "]"}], ",", 
         RowBox[{"x2SHO", "[", "t", "]"}]}], "]"}]}], "}"}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"linearizationMatrixSHO", "//", "MatrixForm"}]}], "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"557502c2-8b3f-4d04-b9a9-655370c18906"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {"0", 
      FractionBox["1", "m"]},
     {
      RowBox[{
       RowBox[{"-", "m"}], " ", 
       SuperscriptBox["\[Omega]", "2"]}], "0"}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Output",
 CellChangeTimes->{3.977324224333881*^9, 3.992688425447858*^9, 
  3.992701705503846*^9, 3.9927019544977217`*^9},
 CellLabel->
  "Out[6]//MatrixForm=",ExpressionUUID->"22bf8961-2ec1-408a-84a8-\
bbea2a383db5"]
}, Open  ]]
