Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"-", "2"}], " ", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"2", " ", "q"}]], " ", 
   SuperscriptBox["\[Beta]", "2"], " ", 
   RowBox[{"b", "[", "t", "]"}]}], "-", 
  RowBox[{"3", " ", "\[Alpha]", " ", "\[Gamma]", " ", 
   RowBox[{"b", "[", "t", "]"}]}], "-", 
  RowBox[{"\[Alpha]", " ", 
   RowBox[{
    SuperscriptBox["a", "\[Prime]",
     MultilineFunction->None], "[", "t", "]"}]}], "+", 
  RowBox[{"4", " ", "\[Beta]", " ", 
