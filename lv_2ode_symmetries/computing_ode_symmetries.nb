Cell[TextData[{
 "This is a \[OpenCurlyDoubleQuote]trick\[CloseCurlyDoubleQuote] where we get \
Mathematica to recognize ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["e", "q"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0cc6b69b-1d21-496b-b6a4-fd12fea7eecb"],
 " as an independent variable."
}], "Text",
