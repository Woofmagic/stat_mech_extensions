  RowBox[{"Q", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"2", " ", 
      SuperscriptBox["\[Beta]", "2"], " ", 
      RowBox[{"b", "[", "t", "]"}]}], "+", 
     RowBox[{"3", " ", "\[Beta]", " ", "\[Gamma]", " ", 
      RowBox[{"b", "[", "t", "]"}]}], "+", 
     RowBox[{"\[Beta]", " ", 
      RowBox[{"d", "[", "t", "]"}]}], "+", 
     RowBox[{"\[Beta]", " ", 
      RowBox[{
       SuperscriptBox["a", "\[Prime]",
        MultilineFunction->None], "[", "t", "]"}]}], "-", 
