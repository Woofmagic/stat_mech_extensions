Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TotalTimeDerivativeOperator", "[", "formalExpression_", "]"}], ":=", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{"formalExpression", ",", "t"}], "]"}], "+", 
    RowBox[{"qdot", " ", 
     RowBox[{"D", "[", 
      RowBox[{"formalExpression", ",", "q"}], "]"}]}], "+", 
    RowBox[{"qddot", " ", 
     RowBox[{"D", "[", 
      RowBox[{"formalExpression", ",", "qp"}], "]"}]}]}]}], ";"}]], "Input",
 InitializationCell->True,
