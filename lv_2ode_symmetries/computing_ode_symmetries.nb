Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "q_", "]"}], ":=", 
   RowBox[{
    RowBox[{"\[Beta]", " ", 
     RowBox[{"Exp", "[", "q", "]"}]}], "-", "\[Alpha]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", "q_", "]"}], ":=", 
   RowBox[{
    RowBox[{"\[Gamma]", " ", "\[Beta]", " ", 
     RowBox[{"Exp", "[", "q", "]"}]}], "-", 
