Cell[CellGroupData[{

Cell["(#0.2.3): Second-Prolongation Operator:", "Subsection",
 CellChangeTimes->{{3.997886715208987*^9, 
  3.9978867218411903`*^9}},ExpressionUUID->"8821f261-b2ba-43e4-9915-\
08f7167f3ba6"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SecondProlongationOperator", "[", 
    RowBox[{"xi_", ",", "eta_"}], "]"}], ":=", 
   RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"xi", " ", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"A", "[", 
         RowBox[{"q", ",", "qdot", ",", "qddot"}], "]"}], ",", "t"}], "]"}]}],
      "+", "\[IndentingNewLine]", 
     RowBox[{"eta", " ", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"A", "[", 
         RowBox[{"q", ",", "qdot", ",", "qddot"}], "]"}], ",", "q"}], "]"}]}],
      "+", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"EtaCoefficient1", "[", 
       RowBox[{"xi", ",", "eta"}], "]"}], " ", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"A", "[", 
         RowBox[{"q", ",", "qdot", ",", "qddot"}], "]"}], ",", "qdot"}], 
       "]"}]}], "+", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"EtaCoefficient2", "[", 
       RowBox[{"xi", ",", "eta"}], "]"}], " ", 
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"A", "[", 
         RowBox[{"q", ",", "qdot", ",", "qddot"}], "]"}], ",", "qddot"}], 
       "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.997886712295684*^9, 3.997886712296417*^9}, {
