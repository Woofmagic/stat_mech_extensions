  3.9978867277995453`*^9}},ExpressionUUID->"1574221b-d273-4ae5-b57b-\
fa982bcd0f7a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"EtaCoefficient1", "[", 
    RowBox[{"xi_", ",", "eta_"}], "]"}], ":=", 
   RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"TotalTimeDerivativeOperator", "[", "eta", "]"}], "-", 
     RowBox[{"qdot", " ", 
      RowBox[{"TotalTimeDerivativeOperator", "[", "xi", "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"EtaCoefficient2", "[", 
    RowBox[{"xi_", ",", "eta_"}], "]"}], ":=", 
   RowBox[{"FullSimplify", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"TotalTimeDerivativeOperator", "[", 
      RowBox[{"eta1", "[", 
       RowBox[{"xi", ",", "eta"}], "]"}], "]"}], "-", 
     RowBox[{"qpp", " ", 
      RowBox[{"TotalTimeDerivativeOperator", "[", "xi", "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9978866548029613`*^9, 3.9978866562661963`*^9}, {
  3.997886731110076*^9, 3.9978867407031517`*^9}, {3.998039631574397*^9, 
