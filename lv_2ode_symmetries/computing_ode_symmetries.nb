650244a714b0"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"LV2ODE", "[", 
    RowBox[{"q_", ",", "qp_", ",", "qpp_"}], "]"}], ":=", 
   RowBox[{"qpp", "+", 
    RowBox[{
     RowBox[{"f", "[", "q", "]"}], " ", "qp"}], "+", 
    RowBox[{"g", "[", "q", "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.997886051403686*^9, 3.99788608694209*^9}, {
  3.997886543299739*^9, 3.997886562692501*^9}},
 CellLabel->"In[13]:=",ExpressionUUID->"6732e686-a6a4-4666-a272-4d722e7320da"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[GothicCapitalI]", "=", 
   RowBox[{
    RowBox[{"\[Beta]", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"q", "[", "t", "]"}], "]"}], "-", 
       RowBox[{"q", "[", "t", "]"}], "-", "1"}], ")"}]}], "-", 
    RowBox[{"\[Alpha]", " ", 
     FractionBox[
      SuperscriptBox[
       RowBox[{"q", "[", "t", "]"}], "2"], "2"]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"F", "=", 
   RowBox[{
    RowBox[{"\[Beta]", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"q", "[", "t", "]"}], "]"}], "-", "1"}], ")"}]}], "-", 
    RowBox[{"\[Alpha]", " ", 
     RowBox[{"q", "[", "t", "]"}]}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.99788787190888*^9, 3.997887900409812*^9}, {
  3.997888175782714*^9, 3.9978881958645687`*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"f01600b3-5c39-47df-aadc-8039716fd5d4"],

Cell[CellGroupData[{

Cell["(#4.X.1): Their Equation (15):", "Subsection",
 CellChangeTimes->{{3.997888266410926*^9, 
  3.997888276844164*^9}},ExpressionUUID->"072f53e0-336c-433f-9f9c-\
368f5cceb31d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"LVEquation15", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"b", "'"}], "[", "t", "]"}], 
        SuperscriptBox[
         RowBox[{"q", "[", "t", "]"}], "2"]}], "-", 
       RowBox[{"2", " ", 
        RowBox[{"b", "[", "t", "]"}], " ", "\[GothicCapitalI]"}], "+", 
       RowBox[{
        RowBox[{"c", "[", "t", "]"}], " ", 
        RowBox[{"q", "[", "t", "]"}]}], "+", 
       RowBox[{"d", "[", "t", "]"}]}], ")"}], 
     RowBox[{
      RowBox[{"f", "'"}], "[", 
      RowBox[{"q", "[", "t", "]"}], "]"}]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"a", "'"}], "[", "t", "]"}], "+", 
       RowBox[{
        RowBox[{
         RowBox[{"b", "'"}], "[", "t", "]"}], " ", 
        RowBox[{"q", "[", "t", "]"}]}]}], ")"}], 
     RowBox[{"f", "[", "q", "]"}]}], "+", 
    RowBox[{"3", " ", 
     RowBox[{"b", "[", "t", "]"}], " ", 
     RowBox[{"g", "[", "q", "]"}]}], "-", 
    RowBox[{"4", " ", 
     RowBox[{
      RowBox[{"b", "'"}], "[", "t", "]"}], "F"}], "+", 
    RowBox[{"3", " ", 
     RowBox[{
      RowBox[{"b", "''"}], "[", "t", "]"}], 
     RowBox[{"q", "[", "t", "]"}]}], "+", 
    RowBox[{"2", 
     RowBox[{
      RowBox[{"c", "'"}], "[", "t", "]"}]}], "-", 
    RowBox[{
     RowBox[{"a", "''"}], "[", "t", "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.997887832539694*^9, 3.9978878686134653`*^9}, {
   3.997887903563355*^9, 3.997887914335338*^9}, {3.9978880688696423`*^9, 
   3.9978880981023684`*^9}, {3.997888152930971*^9, 3.997888209953717*^9}, 
   3.997888241474744*^9, {3.997888614831995*^9, 3.9978886202900763`*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"9ed86e06-f40c-4325-911b-c057b656a29d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"LVEquation15", "/.", 
  RowBox[{
   RowBox[{"q", "[", "t", "]"}], "->", "q"}]}]], "Input",
 CellChangeTimes->{{3.9978889416779213`*^9, 3.997888944296509*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"5b117d03-8401-4a17-af59-fa9172cc4a64"],

Cell[BoxData[
 RowBox[{
  RowBox[{"3", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "\[Alpha]"}], " ", "\[Gamma]"}], "+", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", "q"], " ", "\[Beta]", " ", 
      "\[Gamma]"}]}], ")"}], " ", 
   RowBox[{"b", "[", "t", "]"}]}], "-", 
  RowBox[{"4", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "q"}], " ", "\[Alpha]"}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        SuperscriptBox["\[ExponentialE]", "q"]}], ")"}], " ", "\[Beta]"}]}], 
    ")"}], " ", 
   RowBox[{
    SuperscriptBox["b", "\[Prime]",
     MultilineFunction->None], "[", "t", "]"}]}], "+", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "\[Alpha]"}], "+", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", "q"], " ", "\[Beta]"}]}], ")"}], " ", 
   
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      SuperscriptBox["a", "\[Prime]",
       MultilineFunction->None], "[", "t", "]"}], "+", 
     RowBox[{"q", " ", 
      RowBox[{
       SuperscriptBox["b", "\[Prime]",
        MultilineFunction->None], "[", "t", "]"}]}]}], ")"}]}], "+", 
  RowBox[{
   SuperscriptBox["\[ExponentialE]", "q"], " ", "\[Beta]", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "2"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", 
         FractionBox[
          RowBox[{
           SuperscriptBox["q", "2"], " ", "\[Alpha]"}], "2"]}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", 
           SuperscriptBox["\[ExponentialE]", "q"], "-", "q"}], ")"}], " ", 
         "\[Beta]"}]}], ")"}], " ", 
      RowBox[{"b", "[", "t", "]"}]}], "+", 
     RowBox[{"q", " ", 
      RowBox[{"c", "[", "t", "]"}]}], "+", 
     RowBox[{"d", "[", "t", "]"}], "+", 
     RowBox[{
      SuperscriptBox["q", "2"], " ", 
      RowBox[{
       SuperscriptBox["b", "\[Prime]",
        MultilineFunction->None], "[", "t", "]"}]}]}], ")"}]}], "+", 
  RowBox[{"2", " ", 
   RowBox[{
    SuperscriptBox["c", "\[Prime]",
     MultilineFunction->None], "[", "t", "]"}]}], "-", 
  RowBox[{
   SuperscriptBox["a", "\[Prime]\[Prime]",
    MultilineFunction->None], "[", "t", "]"}], "+", 
  RowBox[{"3", " ", "q", " ", 
   RowBox[{
    SuperscriptBox["b", "\[Prime]\[Prime]",
     MultilineFunction->None], "[", "t", "]"}]}]}]], "Output",
 CellChangeTimes->{3.998161848289227*^9},
 CellLabel->"Out[17]=",ExpressionUUID->"38bc4f8d-d51c-4922-9d5a-52fb55bf26a3"]
}, Open  ]],

