        RowBox[{
         RowBox[{"c", "'"}], "[", "t", "]"}], 
        RowBox[{"q", "[", "t", "]"}]}], "+", 
       RowBox[{
        RowBox[{"d", "'"}], "[", "t", "]"}]}], ")"}], 
     RowBox[{"f", "[", 
      RowBox[{"q", "[", "t", "]"}], "]"}]}], "+", 
    RowBox[{
     RowBox[{
      RowBox[{"b", "'''"}], "[", "t", "]"}], 
