ee41eea0b8aa"],

Cell[BoxData[
 RowBox[{
  RowBox[{"LVEquation16", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"b", "'"}], "[", "t", "]"}], 
        SuperscriptBox[
         RowBox[{"q", "[", "t", "]"}], "2"]}], "-", 
       RowBox[{"2", 
        RowBox[{"b", "[", "t", "]"}], "\[GothicCapitalI]"}], "+", 
       RowBox[{
        RowBox[{"c", "[", "t", "]"}], 
        RowBox[{"q", "[", "t", "]"}]}], "+", 
       RowBox[{"d", "[", "t", "]"}]}], ")"}], 
     RowBox[{
      RowBox[{"g", "'"}], "[", 
      RowBox[{"q", "[", "t", "]"}], "]"}]}], "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"c", "[", "t", "]"}], "-", 
       RowBox[{"2", 
        RowBox[{
         RowBox[{"a", "'"}], "[", "t", "]"}]}], "-", 
       RowBox[{"2", 
        RowBox[{"b", "[", "t", "]"}], "F"}]}], ")"}], 
     RowBox[{"g", "[", 
      RowBox[{"q", "[", "t", "]"}], "]"}]}], "-", 
    RowBox[{"2", 
