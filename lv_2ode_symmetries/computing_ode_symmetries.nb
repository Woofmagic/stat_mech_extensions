Cell["(#4.1): Lienard-Type Functions:", "Section",
 CellChangeTimes->{{3.997886550132419*^9, 
  3.997886556777341*^9}},ExpressionUUID->"fcaecbd0-641f-471b-8705-\
e155b37c3734"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "q_", "]"}], ":=", 
   RowBox[{
    RowBox[{"\[Beta]", " ", 
     RowBox[{"Exp", "[", "q", "]"}]}], "-", "\[Alpha]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", "q_", "]"}], ":=", 
   RowBox[{
    RowBox[{"\[Gamma]", " ", "\[Beta]", " ", 
     RowBox[{"Exp", "[", "q", "]"}]}], "-", 
    RowBox[{"\[Alpha]", " ", "\[Gamma]"}]}]}], ";"}]}], "Input",
 CellLabel->"In[7]:=",ExpressionUUID->"ab9bd211-168c-453b-bc5e-28daf7cdc383"]
}, Open  ]],

Cell[CellGroupData[{

Cell["(#4.2): The ODE:", "Section",
 CellChangeTimes->{{3.99788606933779*^9, 3.9978860759983253`*^9}, 
   3.997886545432876*^9},ExpressionUUID->"6e273ec4-bc7c-45d4-b8c6-\
650244a714b0"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"LV2ODE", "[", 
    RowBox[{"q_", ",", "qp_", ",", "qpp_"}], "]"}], ":=", 
   RowBox[{"qpp", "+", 
    RowBox[{
     RowBox[{"f", "[", "q", "]"}], " ", "qp"}], "+", 
    RowBox[{"g", "[", "q", "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.997886051403686*^9, 3.99788608694209*^9}, {
  3.997886543299739*^9, 3.997886562692501*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"6732e686-a6a4-4666-a272-4d722e7320da"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[GothicCapitalI]", "=", 
   RowBox[{
    RowBox[{"\[Beta]", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"q", "[", "t", "]"}], "]"}], "-", 
       RowBox[{"q", "[", "t", "]"}], "-", "1"}], ")"}]}], "-", 
    RowBox[{"\[Alpha]", " ", 
     FractionBox[
      SuperscriptBox[
       RowBox[{"q", "[", "t", "]"}], "2"], "2"]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"F", "=", 
   RowBox[{
    RowBox[{"\[Beta]", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"q", "[", "t", "]"}], "]"}], "-", "1"}], ")"}]}], "-", 
    RowBox[{"\[Alpha]", " ", 
     RowBox[{"q", "[", "t", "]"}]}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.99788787190888*^9, 3.997887900409812*^9}, {
  3.997888175782714*^9, 3.9978881958645687`*^9}},
 CellLabel->"In[10]:=",ExpressionUUID->"f01600b3-5c39-47df-aadc-8039716fd5d4"],

Cell[CellGroupData[{

Cell["(#4.X.1): Their Equation (15):", "Subsection",
 CellChangeTimes->{{3.997888266410926*^9, 
  3.997888276844164*^9}},ExpressionUUID->"072f53e0-336c-433f-9f9c-\
368f5cceb31d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"LVEquation15", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"b", "'"}], "[", "t", "]"}], 
        SuperscriptBox[
         RowBox[{"q", "[", "t", "]"}], "2"]}], "-", 
       RowBox[{"2", " ", 
        RowBox[{"b", "[", "t", "]"}], " ", "\[GothicCapitalI]"}], "+", 
       RowBox[{
        RowBox[{"c", "[", "t", "]"}], " ", 
        RowBox[{"q", "[", "t", "]"}]}], "+", 
       RowBox[{"d", "[", "t", "]"}]}], ")"}], 
     RowBox[{
      RowBox[{"f", "'"}], "[", 
      RowBox[{"q", "[", "t", "]"}], "]"}]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"a", "'"}], "[", "t", "]"}], "+", 
       RowBox[{
        RowBox[{
         RowBox[{"b", "'"}], "[", "t", "]"}], " ", 
        RowBox[{"q", "[", "t", "]"}]}]}], ")"}], 
     RowBox[{"f", "[", "q", "]"}]}], "+", 
    RowBox[{"3", " ", 
     RowBox[{"b", "[", "t", "]"}], " ", 
     RowBox[{"g", "[", "q", "]"}]}], "-", 
    RowBox[{"4", " ", 
     RowBox[{
      RowBox[{"b", "'"}], "[", "t", "]"}], "F"}], "+", 
    RowBox[{"3", " ", 
     RowBox[{
      RowBox[{"b", "''"}], "[", "t", "]"}], 
     RowBox[{"q", "[", "t", "]"}]}], "+", 
    RowBox[{"2", 
     RowBox[{
      RowBox[{"c", "'"}], "[", "t", "]"}]}], "-", 
    RowBox[{
     RowBox[{"a", "''"}], "[", "t", "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.997887832539694*^9, 3.9978878686134653`*^9}, {
   3.997887903563355*^9, 3.997887914335338*^9}, {3.9978880688696423`*^9, 
   3.9978880981023684`*^9}, {3.997888152930971*^9, 3.997888209953717*^9}, 
   3.997888241474744*^9, {3.997888614831995*^9, 3.9978886202900763`*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"9ed86e06-f40c-4325-911b-c057b656a29d"],

Cell[BoxData[
 RowBox[{"LVEquation15", "/.", 
  RowBox[{
   RowBox[{"q", "[", "t", "]"}], "->", "q"}]}]], "Input",
 CellChangeTimes->{{3.9978889416779213`*^9, 3.997888944296509*^9}},
 CellLabel->"In[13]:=",ExpressionUUID->"5b117d03-8401-4a17-af59-fa9172cc4a64"],

Cell[BoxData[
 RowBox[{
  RowBox[{"LVEquation15qOnly", "=", 
   RowBox[{"Expand", "[", 
    RowBox[{"LVEquation15", "/.", " ", 
     RowBox[{
      RowBox[{"q", "[", "t", "]"}], "->", "q"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.997888954827207*^9, 3.9978889563867617`*^9}, {
   3.997889799295377*^9, 3.99788980731147*^9}, 3.997889992043058*^9, 
   3.997890023229682*^9},
 CellLabel->"In[14]:=",ExpressionUUID->"c4c82e74-4605-403f-a541-10fd8a88264e"],

Cell[TextData[{
 "This is a \[OpenCurlyDoubleQuote]trick\[CloseCurlyDoubleQuote] where we get \
Mathematica to recognize ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["e", "q"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0cc6b69b-1d21-496b-b6a4-fd12fea7eecb"],
 " as an independent variable."
}], "Text",
 CellChangeTimes->{{3.9978898276402197`*^9, 
  3.997889872376652*^9}},ExpressionUUID->"a1548c39-0957-4b65-ad56-\
afb43b034744"],

Cell[BoxData[
 RowBox[{
  RowBox[{"LVEquation15FormalVariables", "=", 
   RowBox[{"LVEquation15qOnly", "/.", " ", 
    RowBox[{
     RowBox[{"Exp", "[", "q", "]"}], "->", "Q"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9978898255850058`*^9, 3.9978898902463903`*^9}, {
  3.9978899898141623`*^9, 3.9978900018356524`*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"59fba92e-5837-42f6-aee3-ad68b1a843b2"],

Cell[BoxData[
 RowBox[{"Collect", "[", 
  RowBox[{"LVEquation15FormalVariables", ",", 
   RowBox[{"{", 
    RowBox[{"q", ",", "Q"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.997889882645471*^9, 3.997889886630105*^9}, {
  3.997889990802403*^9, 3.997890008162952*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"d30830b2-ae03-4bfc-895c-dc1366ede1a1"],

Cell[BoxData[
 RowBox[{"DSolve", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"b", "[", "t", "]"}], "==", "0"}], ",", 
     RowBox[{
      RowBox[{"c", "[", "t", "]"}], "==", "0"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"d", "[", "t", "]"}], "+", 
       RowBox[{
        RowBox[{"a", "'"}], "[", "t", "]"}]}], "==", "0"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"a", "''"}], "[", "t", "]"}], "+", 
       RowBox[{"\[Alpha]", " ", 
        RowBox[{
         RowBox[{"a", "'"}], "[", "t", "]"}]}]}], "==", "0"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"a", ",", "b", ",", "c", ",", "d"}], "}"}], ",", "t"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.997889948880987*^9, 3.997889948881609*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"dc99d649-1b49-4c80-80b4-360eec0baa0b"]
}, Open  ]],

