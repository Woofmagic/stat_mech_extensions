Notebook[{

Cell[CellGroupData[{
Cell["Nonhamiltonian Mechanics as Curvature?", "Title",
 CellChangeTimes->{{3.960476141630527*^9, 3.960476153706421*^9}, {
  3.960541610193521*^9, 
  3.960541619951116*^9}},ExpressionUUID->"f69efa94-0ee5-4595-b1b2-\
f6a4c534fd9c"],

Cell["\<\
We examine the possibility of nonhamiltonian systems as having nontrivial \
curvature as per Tuckerman et al.\
\>", "Subtitle",
 CellChangeTimes->{{3.960541621129274*^9, 
  3.960541652206909*^9}},ExpressionUUID->"dcb8e82a-371c-43d7-9e22-\
73da1aff2d15"],

Cell[CellGroupData[{

Cell["(#0): Loading Packages:", "Chapter",
 CellChangeTimes->{{3.9604761552941313`*^9, 
  3.960476172350193*^9}},ExpressionUUID->"f43a004a-be65-4661-88c1-\
f987f21875cc"],

Cell[BoxData[{
 RowBox[{"<<", "xAct`xTensor`"}], "\[IndentingNewLine]", 
 RowBox[{"<<", "xAct`xCoba`"}]}], "Input",
 CellChangeTimes->{{3.9604769500074368`*^9, 3.9604769501771393`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"03563a54-6ab1-4770-9e2d-eb11e5089d75"]
}, Open  ]],

Cell[CellGroupData[{

Cell["(#1): Lotka-Volterra System", "Chapter",
 CellChangeTimes->{{3.960476175743062*^9, 3.9604761873248053`*^9}, {
  3.960541658965097*^9, 
  3.960541661565267*^9}},ExpressionUUID->"f1f525e9-17e4-4c41-a4d6-\
3108b5b82dcd"],

Cell[CellGroupData[{

Cell["(#1.1): First Pass | Off-Diagonal Metric:", "Section",
 CellChangeTimes->{
  3.960542234363141*^9},ExpressionUUID->"edd0ba45-a00b-4c3c-b0de-\
35e8f660e096"],

Cell[TextData[{
 "The LV system is 2D. We found nontrivial compressibility, leading to a \
metric determinant of ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "xy"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cf625799-e29c-47d6-ad10-c9d8f1cf819d"],
 ". Can we find metric components that yield this determinant?"
}], "Text",
 CellChangeTimes->{{3.960541663332802*^9, 
  3.960541697376174*^9}},ExpressionUUID->"3a985bbe-4fcb-403e-a31a-\
663bb7d6b040"],

Cell["We first define a 2D manifold (\[OpenCurlyDoubleQuote]surface\
\[CloseCurlyDoubleQuote]):", "Text",
 CellChangeTimes->{{3.960541744689097*^9, 
  3.960541753555277*^9}},ExpressionUUID->"a91122f6-a1a1-431b-b77a-\
72a915cad3f1"],

Cell[CellGroupData[{

Cell["(#1.1.1): 2D Manifold:", "Subsection",
 CellChangeTimes->{{3.960542244259014*^9, 
  3.9605422509893503`*^9}},ExpressionUUID->"9fb2e2aa-3188-44cb-abd5-\
1ba0a8a98653"],

Cell[BoxData[
 RowBox[{"DefManifold", "[", 
  RowBox[{"M", ",", "2", ",", 
   RowBox[{"IndexRange", "[", 
    RowBox[{"a", ",", "m"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[3]:=",ExpressionUUID->"f582e11a-53ea-4a7b-915e-6e18858f4357"],

Cell["Next, define a coordinate chart:", "Text",
 CellChangeTimes->{{3.960541755984023*^9, 
  3.960541759504692*^9}},ExpressionUUID->"58024837-0fc8-4f83-be48-\
1b1724eb433d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["(#1.1.2): Coordinate Chart:", "Subsection",
 CellChangeTimes->{
  3.960542259215657*^9},ExpressionUUID->"a4fc45ec-4455-4aac-83d6-\
5853bbe7b0de"],

Cell[BoxData[
 RowBox[{"DefChart", "[", 
  RowBox[{"Chart1", ",", "M", ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "[", "]"}], ",", 
     RowBox[{"y", "[", "]"}]}], "}"}], ",", 
   RowBox[{"ChartColor", "->", "Blue"}]}], "]"}]], "Input",
 CellChangeTimes->{3.960542224187036*^9},
 CellLabel->"In[4]:=",ExpressionUUID->"7e797ce0-fef6-4a8d-9c02-3882b31a004f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["(#1.1.3): Metric Tensor:", "Subsection",
 CellChangeTimes->{{3.9604764377721853`*^9, 3.960476445086087*^9}, {
   3.960476510471113*^9, 3.960476510561716*^9}, 3.960476854364657*^9, {
   3.960542131609453*^9, 
   3.960542133835017*^9}},ExpressionUUID->"590a4d06-2c26-4c2c-bdc3-\
c4f8042fa983"],

Cell[BoxData[
 RowBox[{"Metric1", "=", 
  RowBox[{"DefMetric", "[", 
   RowBox[{
    RowBox[{"-", "1"}], ",", 
    RowBox[{"g", "[", 
     RowBox[{
      RowBox[{"-", "a"}], ",", 
      RowBox[{"-", "b"}]}], "]"}], ",", "CD", ",", 
    RowBox[{"{", "\"\<\[Del]\>\"", "}"}], ",", 
    RowBox[{"PrintAs", "->", "\"\<g\>\""}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.960542143888801*^9, 3.960542189312998*^9}, {
  3.9605425875822077`*^9, 3.9605425895004997`*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"83a352dd-ebcf-40da-84dd-bb0a0f00d158"],

Cell[BoxData[
 RowBox[{"CD", "=", 
  RowBox[{"CovDOfMetric", "[", "Metric1", "]"}]}]], "Input",
 CellChangeTimes->{{3.960542602016753*^9, 3.960542608886456*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"8d403e07-8b7d-4b18-8e20-7f74f36134c0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["(#1.1.4): Metric Components:", "Subsection",
 CellChangeTimes->{{3.960542145476223*^9, 
  3.960542154652141*^9}},ExpressionUUID->"59ce308f-5425-43a1-b585-\
32e33a1f446d"],

Cell[BoxData[
 RowBox[{"DefTensor", "[", 
  RowBox[{
   RowBox[{"Metric1Components", "[", 
    RowBox[{
     RowBox[{"-", "a"}], ",", 
     RowBox[{"-", "b"}]}], "]"}], ",", 
   RowBox[{"{", "M", "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9605419687914877`*^9, 3.9605419687923183`*^9}, {
  3.9605420248397303`*^9, 3.960542041434503*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"7283d836-ca5f-47cb-a7a2-ad36ff3fd704"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Metric1Components", "[", 
     RowBox[{"1", ",", "1"}], "]"}], "=", 
    RowBox[{"Exp", "[", 
     RowBox[{"2", " ", "x"}], "]"}]}], ";"}], "  "}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Metric1Components", "[", 
     RowBox[{"1", ",", "2"}], "]"}], "=", "0"}], ";"}], " "}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Metric1Components", "[", 
    RowBox[{"2", ",", "1"}], "]"}], "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Metric1Components", "[", 
    RowBox[{"2", ",", "2"}], "]"}], "=", 
   RowBox[{"Exp", "[", 
    RowBox[{"2", " ", "y"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9605420514643927`*^9, 3.960542061369103*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"69dc053c-cc4e-42d9-b7b0-72875fcd6b47"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ToComponents", "[", 
   RowBox[{
    RowBox[{"g", "[", 
     RowBox[{
      RowBox[{"-", "a"}], ",", 
      RowBox[{"-", "b"}]}], "]"}], ",", "Chart1"}], "]"}], "=", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Metric1Components", "[", 
        RowBox[{"1", ",", "1"}], "]"}], ",", 
       RowBox[{"Metric1Components", "[", 
        RowBox[{"1", ",", "2"}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Metric1Components", "[", 
        RowBox[{"2", ",", "1"}], "]"}], ",", 
       RowBox[{"Metric1Components", "[", 
        RowBox[{"2", ",", "2"}], "]"}]}], "}"}]}], "\[IndentingNewLine]", 
    "}"}], "//", "Simplify"}]}]], "Input",
 CellChangeTimes->{{3.960477119379863*^9, 3.960477198056579*^9}, {
  3.960542069188813*^9, 3.96054209694375*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"c883326a-1438-493b-b989-9f06013bbe9d"],

Cell[BoxData[
 RowBox[{"ChristoffelSymbols", "=", 
  RowBox[{"Christoffel", "[", 
   RowBox[{"CD", ",", 
    RowBox[{"-", "a"}], ",", 
    RowBox[{"-", "b"}], ",", 
    RowBox[{"-", "c"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.960542115487502*^9, 3.9605421154883223`*^9}},
 CellLabel->"In[13]:=",ExpressionUUID->"31fe6e03-c30d-4242-ba15-7eb854fe4f5b"],

Cell[BoxData[
 RowBox[{"RiemannCD", "=", 
  RowBox[{
   RowBox[{"RiemannTensor", "[", "CD", "]"}], "[", 
   RowBox[{
    RowBox[{"-", "a"}], ",", 
    RowBox[{"-", "b"}], ",", 
    RowBox[{"-", "c"}], ",", 
    RowBox[{"-", "d"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.960542544974028*^9, 3.960542562615367*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"d6410d38-8ab4-4728-b090-e68b52f8daef"],

Cell[BoxData[
 RowBox[{"MetricCompute", "[", "Metric1", "]"}]], "Input",
 CellChangeTimes->{{3.9605425759451637`*^9, 3.960542596814736*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"4968de1b-9615-4684-90de-109ae55b9659"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

