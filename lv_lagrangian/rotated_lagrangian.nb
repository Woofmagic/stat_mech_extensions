         RowBox[{
          RowBox[{"p", "[", "t", "]"}], "-", 
          RowBox[{"q", "[", "t", "]"}]}], 
         SqrtBox["2"]]], " ", "\[Delta]"}], 
      SqrtBox["2"]]}], ",", "t"}], "]"}]}]], "Input",
