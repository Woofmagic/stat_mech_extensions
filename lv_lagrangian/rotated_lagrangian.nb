Cell[BoxData[
 RowBox[{
  RowBox[{"-", 
   FractionBox[
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          SqrtBox["2"], " ", 
          RowBox[{"q", "[", "t", "]"}]}]], " ", "\[Beta]", " ", "\[Gamma]"}], 
       "-", 
       RowBox[{"\[Alpha]", " ", "\[Delta]"}]}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{"\[Alpha]", "+", "\[Gamma]", "+", 
