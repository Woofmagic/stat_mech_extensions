hand:", "Text",
 CellChangeTimes->{{3.997988392436947*^9, 
  3.9979884006392*^9}},ExpressionUUID->"e1ec47ab-9d08-4000-a83e-e19011574064"],

Cell[BoxData[
 RowBox[{"pRotatedConjugate", "=", 
  RowBox[{
   SqrtBox["2"], 
   RowBox[{"Log", "[", 
    FractionBox[
     RowBox[{
      RowBox[{"Exp", "[", 
       FractionBox["q", 
        SqrtBox["2"]], "]"}], 
      RowBox[{"(", 
       RowBox[{"\[Alpha]", "+", "\[Gamma]", "+", 
