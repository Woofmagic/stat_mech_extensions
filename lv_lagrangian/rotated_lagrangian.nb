Cell[BoxData[{
 RowBox[{"qRotatedDot", "=", 
  RowBox[{"D", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       FractionBox[
        RowBox[{
         RowBox[{"p", "[", "t", "]"}], "+", 
         RowBox[{"q", "[", "t", "]"}]}], 
        SqrtBox["2"]]], " ", "\[Beta]"}], "+", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       FractionBox[
        RowBox[{
         RowBox[{"p", "[", "t", "]"}], "-", 
         RowBox[{"q", "[", "t", "]"}]}], 
        SqrtBox["2"]]], " ", "\[Delta]"}], "+", 
     FractionBox[
      RowBox[{
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"\[Alpha]", "+", "\[Gamma]"}], ")"}], " ", 
          RowBox[{"p", "[", "t", "]"}]}], ")"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "\[Alpha]"}], "+", "\[Gamma]"}], ")"}], " ", 
        RowBox[{"q", "[", "t", "]"}]}]}], 
      SqrtBox["2"]]}], ",", 
    RowBox[{"p", "[", "t", "]"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"pRotatedDot", "=", 
  RowBox[{"-", 
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        FractionBox[
         RowBox[{
          RowBox[{"p", "[", "t", "]"}], "+", 
          RowBox[{"q", "[", "t", "]"}]}], 
         SqrtBox["2"]]], " ", "\[Beta]"}], "+", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        FractionBox[
         RowBox[{
          RowBox[{"p", "[", "t", "]"}], "-", 
          RowBox[{"q", "[", "t", "]"}]}], 
         SqrtBox["2"]]], " ", "\[Delta]"}], "+", 
      FractionBox[
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"\[Alpha]", "+", "\[Gamma]"}], ")"}], " ", 
           RowBox[{"p", "[", "t", "]"}]}], ")"}]}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "\[Alpha]"}], "+", "\[Gamma]"}], ")"}], " ", 
