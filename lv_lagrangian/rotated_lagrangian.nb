      RowBox[{"\[Alpha]", "+", "\[Gamma]", "+", 
       RowBox[{
        SqrtBox["2"], 
        RowBox[{
         RowBox[{"q", "'"}], "[", "t", "]"}]}]}], ")"}]}], "-", 
    RowBox[{
     FractionBox[
      RowBox[{"q", "[", "t", "]"}], 
      SqrtBox["2"]], 
     RowBox[{"(", 
      RowBox[{"\[Gamma]", "-", "\[Alpha]"}], ")"}]}]}]}], ";"}]], "Input",
