Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       FractionBox[
        RowBox[{"p", "+", "q"}], 
        SqrtBox["2"]]], " ", "\[Beta]"}], "+", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
