Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CIntOfMotion", "/.", 
    RowBox[{
     RowBox[{"y", "[", "t", "]"}], "->", 
     RowBox[{"Exp", "[", 
      FractionBox[
       RowBox[{
        RowBox[{"p", "[", "t", "]"}], "+", 
        RowBox[{"q", "[", "t", "]"}]}], 
       SqrtBox["2"]], "]"}]}]}], "/.", 
   RowBox[{
    RowBox[{"x", "[", "t", "]"}], "->", 
    RowBox[{"Exp", "[", 
     FractionBox[
      RowBox[{
       RowBox[{"p", "[", "t", "]"}], "-", 
       RowBox[{"q", "[", "t", "]"}]}], 
      SqrtBox["2"]], "]"}]}]}], "//", "FullSimplify"}]], "Input",
