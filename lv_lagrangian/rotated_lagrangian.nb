Cell[BoxData[
 RowBox[{"CIntOfMotion", "=", 
  RowBox[{
   RowBox[{"\[Delta]", " ", 
    RowBox[{"x", "[", "t", "]"}]}], "-", 
   RowBox[{"\[Gamma]", " ", 
    RowBox[{"Log", "[", 
     RowBox[{"x", "[", "t", "]"}], "]"}]}], "+", 
   RowBox[{"\[Beta]", " ", 
    RowBox[{"y", "[", "t", "]"}]}], "-", 
   RowBox[{"\[Alpha]", " ", 
    RowBox[{"Log", "[", 
     RowBox[{"y", "[", "t", "]"}], "]"}]}]}]}]], "Input",
