          RowBox[{"-", "\[Alpha]"}], "+", "\[Gamma]"}], ")"}], " ", "q"}]}], 
      SqrtBox["2"]]}], ")"}], "/.", 
   RowBox[{"p", "->", "pRotatedConjugate"}]}], "//", 
