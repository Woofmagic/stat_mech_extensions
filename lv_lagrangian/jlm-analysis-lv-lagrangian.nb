Cell["(#X): Some Other Stuff:", "Chapter",
 CellChangeTimes->{{3.9982372900507383`*^9, 
  3.998237295525629*^9}},ExpressionUUID->"75380c1b-4e41-4ed1-9335-\
1926dd5839e5"],

Cell[CellGroupData[{

Cell["(#X.1): Trying to brute-force solve the PDE:", "Section",
 CellChangeTimes->{{3.998237298938768*^9, 
  3.998237313983042*^9}},ExpressionUUID->"6d289d1f-3eed-4d90-ba14-\
0e4f074c16b2"],

Cell[CellGroupData[{

Cell["(#X.1.1): Defining the PDE:", "Subsection",
 CellChangeTimes->{{3.998237357565013*^9, 
  3.99823736516848*^9}},ExpressionUUID->"4e392aac-79dd-467b-8fd1-\
992b22d0caca"],

Cell[BoxData[
 RowBox[{"JLMFODPDE", " ", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"JLMSolution", "[", 
       RowBox[{"q", ",", "v", ",", "t"}], "]"}], ",", "t"}], "]"}], "+", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"JLMSolution", "[", 
        RowBox[{"q", ",", "v", ",", "t"}], "]"}], ",", "q"}], "]"}], "v"}], 
    "+", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"JLMSolution", "[", 
        RowBox[{"q", ",", "v", ",", "t"}], "]"}], ",", "v"}], "]"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[Beta]", " ", 
        RowBox[{"Exp", "[", "q", "]"}]}], "-", "\[Alpha]"}], ")"}], 
     RowBox[{"(", 
      RowBox[{"v", "-", "\[Gamma]"}], ")"}]}]}], "==", "0"}]}]], "Input",
 CellChangeTimes->{{3.9982373243148603`*^9, 3.998237340995489*^9}, {
  3.998237403523787*^9, 3.998237447833961*^9}, {3.998240224231555*^9, 
  3.998240225206572*^9}, {3.998240266495954*^9, 3.998240304472679*^9}},
 CellLabel->"In[43]:=",ExpressionUUID->"e0aa4b6c-5bc4-464b-9010-374e7a3e3f7a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["(#X.1.2): Solving the PDE:", "Subsection",
 CellChangeTimes->{{3.998237367258628*^9, 
  3.9982373714080048`*^9}},ExpressionUUID->"a9823158-df78-42a9-bded-\
2036993d1bae"],

Cell[BoxData[
 RowBox[{"JLMFODSolutionToPDE", "=", 
  RowBox[{"DSolve", "[", 
   RowBox[{"JLMFODPDE", ",", 
    RowBox[{"JLMSolution", "[", 
     RowBox[{"q", ",", "v", ",", "t"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"q", ",", "v", ",", "t"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9982373718120613`*^9, 3.998237397420528*^9}, 
   3.998240253558365*^9, {3.998240293864396*^9, 3.998240294125577*^9}},
