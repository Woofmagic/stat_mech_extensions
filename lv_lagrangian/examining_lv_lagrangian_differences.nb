  3.99631684623104*^9}},ExpressionUUID->"e6c36427-44d2-463e-bce9-\
ff1fa5af4dcf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Pham2022Lagrangian", "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], 
     SuperscriptBox[
      RowBox[{"(", 
       FractionBox[
        RowBox[{
         RowBox[{"w1", "'"}], "[", "t", "]"}], 
        RowBox[{"w1", "[", "t", "]"}]], ")"}], "2"]}], "+", 
    RowBox[{
     FractionBox["1", "2"], 
     SuperscriptBox[
      RowBox[{"(", 
       FractionBox[
        RowBox[{
         RowBox[{"w2", "'"}], "[", "t", "]"}], 
        RowBox[{"w2", "[", "t", "]"}]], ")"}], "2"]}], "-", 
    RowBox[{"a", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"B", " ", 
        RowBox[{"w1", "[", "t", "]"}]}], "+", 
       RowBox[{"A", " ", 
        RowBox[{"Log", "[", 
         RowBox[{"Abs", "[", 
          RowBox[{"w1", "[", "t", "]"}], "]"}], "]"}]}]}], ")"}]}], "-", 
    RowBox[{"A", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"b", " ", 
        RowBox[{"w2", "[", "t", "]"}]}], "+", 
       RowBox[{"a", " ", 
        RowBox[{"Log", "[", 
         RowBox[{"Abs", "[", 
          RowBox[{"w2", "[", "t", "]"}], "]"}], "]"}]}]}], ")"}]}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.996316740692422*^9, 3.996316833103209*^9}, {
  3.996316920334577*^9, 3.996316921732007*^9}, {3.996318171576226*^9, 
  3.99631817495574*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"726c75d5-4a6f-48f2-bd14-4788a26faa1c"]
}, Open  ]],

