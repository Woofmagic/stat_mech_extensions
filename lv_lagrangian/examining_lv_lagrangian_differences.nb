Cell["(#0): Global Assumptions:", "Chapter",
 CellChangeTimes->{{3.9963169550982656`*^9, 
  3.996316958859449*^9}},ExpressionUUID->"d4a6100c-36a4-4e10-afd1-\
349007c9e13d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"$Assumptions", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"t", "\[Element]", "Reals"}], "&&", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"Pham", " ", "2022", " ", "Parameters"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"a", "\[Element]", "Reals"}], "&&", 
     RowBox[{"b", "\[Element]", "Reals"}], "&&", 
     RowBox[{"A", "\[Element]", "Reals"}], "&&", 
     RowBox[{"B", "\[Element]", "Reals"}], "&&", 
     RowBox[{
      RowBox[{"w1", "[", "t", "]"}], ">", "0"}], "&&", 
     RowBox[{
      RowBox[{"w2", "[", "t", "]"}], ">", "0"}], "&&", "\[IndentingNewLine]", 
     
     RowBox[{"(*", " ", 
      RowBox[{"Nunez", " ", "1998", " ", "Parameters"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"a", "\[Element]", "Reals"}], "&&", 
     RowBox[{"b", "\[Element]", "Reals"}], "&&", 
     RowBox[{
      RowBox[{"x", "[", "t", "]"}], "\[Element]", "PositiveReals"}], "&&", 
     RowBox[{
      RowBox[{"y", "[", "t", "]"}], "\[Element]", "PositiveReals"}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.996316959797595*^9, 3.9963169622245617`*^9}, {
  3.9963172021827507`*^9, 3.996317235454472*^9}, {3.996318630731977*^9, 
  3.996318676566578*^9}, {3.996318888172839*^9, 3.996318961816304*^9}, {
  3.9963190248564177`*^9, 3.996319031877048*^9}, {3.996319152000547*^9, 
  3.99631916315212*^9}, {3.996319406435665*^9, 3.996319437717167*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"67a1bb1f-ad4e-40ba-b07c-4d796596f59e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["(#1): Pham\[CloseCurlyQuote]s Lagrangian:", "Chapter",
 CellChangeTimes->{{3.9963167115136414`*^9, 
  3.9963167213924007`*^9}},ExpressionUUID->"e7572d21-9fd9-41be-8230-\
13df5d6d0752"],

Cell["\<\
FYI: this Lagrangian re-derives fundamentally different \
\[OpenCurlyDoubleQuote]equations of motion,\[CloseCurlyDoubleQuote] in the \
sense that they are second-order already after taking time-derivatives of the \
(first-order!) original LV equations! So, there\[CloseCurlyQuote]s not much \
sense in actually using this calculation for any type of cross-check...\
\>", "Text",
 CellChangeTimes->{{3.996331374984268*^9, 
  3.996331426203167*^9}},ExpressionUUID->"84ae4aa6-e1be-41ed-ab3e-\
6be342c4eb0b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["(#1.1): Lagrangian:", "Subtitle",
