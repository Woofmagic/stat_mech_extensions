Cell[CellGroupData[{
Cell["\<\
Why are there so many Different-Looking Lagrangians? They should all give the \
same Dynamics:\
\>", "Title",
 CellChangeTimes->{{3.996316702497961*^9, 3.996316709842984*^9}, {
  3.99631697312455*^9, 
  3.9963169772791243`*^9}},ExpressionUUID->"6b9300e6-9f36-4c85-9eb8-\
70a61a81f73a"],

